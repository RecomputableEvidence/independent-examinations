{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RecomputableEvidence/independent-examinations/blob/main/schema/receipt-v0.1.schema.json",
  "title": "Independent examination output receipt v0.1",
  "description": "A reported implementation output; not a truth/authorization oracle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "subject_sha256", "implementation_id", "platform_id", "results"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "experiment_id": {"$ref": "#/$defs/identifier"},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_id": {"$ref": "#/$defs/identifier"},
    "platform_id": {"$ref": "#/$defs/identifier"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "arm", "cohort", "status", "reason", "exception"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "arm": {"$ref": "#/$defs/identifier"},
        "cohort": {"enum": ["registered", "exploratory", "holdout_revealed"]},
        "status": {"enum": ["CONTINUE", "WITHHOLD", "STOP", "UNRESOLVED", "EXCEPTION"]},
        "reason": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 255}, {"type": "null"}]},
        "exception": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 255}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "EXCEPTION"}}},
          "then": {"properties": {"reason": {"type": "null"}, "exception": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"reason": {"type": "string", "minLength": 1}, "exception": {"type": "null"}}}
        }
      ]
    }
  }
}
